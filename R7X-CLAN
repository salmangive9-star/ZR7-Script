local ARem, CRem
local ProtectionEnabled = false

local function AntiAdmin()
    pcall(function()
        CRem = ReplicatedStorage:FindFirstChild("ChatEvent", true)
        for _, d in pairs(ReplicatedStorage:GetDescendants()) do
            if d:IsA("RemoteFunction") and (d.Name == "RequestCommandModification" or d.Name:match("Modification")) then
                ARem = d
                break
            end
        end
        local h = ReplicatedStorage:FindFirstChild("HDAdminHDClient") or game:GetService("JointsService"):FindFirstChild("HDAdminHDClient")
        if h and h:FindFirstChild("Assets") and h.Assets:FindFirstChild("NightVision") then
            h.Assets.NightVision:Destroy()
        end
        local g = LocalPlayer.PlayerGui:FindFirstChild("HDAdminInterface") or LocalPlayer.PlayerGui:FindFirstChild("HDAdminGui")
        if g then g:Destroy() end
    end)
end

task.spawn(function()
    while task.wait(1) do
        if ProtectionEnabled then AntiAdmin() end
    end
end)

local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "ZR7_ESP_Holder"
pcall(function() ESPFolder.Parent = CoreGui end)
if not ESPFolder.Parent then ESPFolder.Parent = TargetGuiParent end

local espEnabled = false

local function RestoreDefaultNames()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") then
            player.Character.Humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
        end
    end
end

local function CreateESP(player)
    if player == LocalPlayer then return end
    local character = player.Character
    if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") then
        character.Humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        local hrp = character.HumanoidRootPart

        local Billboard = Instance.new("BillboardGui")
        Billboard.Name = player.Name .. "_Name"
        Billboard.Parent = ESPFolder
        Billboard.Adornee = hrp
        Billboard.Size = UDim2.new(0, 200, 0, 50)
        Billboard.StudsOffset = Vector3.new(0, 3, 0)
        Billboard.AlwaysOnTop = true

        local NameLabel = Instance.new("TextLabel")
        NameLabel.Parent = Billboard
        NameLabel.Size = UDim2.new(1, 0, 1, 0)
        NameLabel.BackgroundTransparency = 1
        NameLabel.Text = player.DisplayName .. " (@" .. player.Name .. ")"
        NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        NameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        NameLabel.TextStrokeTransparency = 0
        NameLabel.Font = Enum.Font.GothamBold
        NameLabel.TextSize = 14

        local Highlight = Instance.new("Highlight")
        Highlight.Name = player.Name .. "_Highlight"
        Highlight.Parent = ESPFolder
        Highlight.Adornee = character
        Highlight.FillColor = CyberTheme.MainColor
        Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        Highlight.FillTransparency = 0.5
        Highlight.OutlineTransparency = 0.2
        Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        CyberTheme.ObjectsToColor[Highlight] = "FillColor"
    end
end

local function UpdateESP()
    ESPFolder:ClearAllChildren()
    if espEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            CreateESP(player)
        end
    end
end

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        task.wait(1)
        if espEnabled then UpdateESP() end
    end)
end)

for _, player in pairs(Players:GetPlayers()) do
    player.CharacterAdded:Connect(function()
        task.wait(1)
        if espEnabled then UpdateESP() end
    end)
end

