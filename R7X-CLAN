local LangData = {}
local IsEnglish = false

local function RegisterLang(obj, arText, enText, isPlaceholder, isRichText)
    table.insert(LangData, {Obj = obj, AR = arText, EN = enText, IsPlaceholder = isPlaceholder, IsRichText = isRichText})
    if isPlaceholder then
        obj.PlaceholderText = IsEnglish and enText or arText
    else
        obj.Text = IsEnglish and enText or arText
    end
end

local function UpdateLanguage()
    for _, data in pairs(LangData) do
        local newText = IsEnglish and data.EN or data.AR
        if data.Obj and data.Obj.Parent then
            if data.IsPlaceholder then
                data.Obj.PlaceholderText = newText
            else
                data.Obj.Text = newText
            end
        end
    end
end

-- ========================================================
-- [ نظام الألوان الديناميكي المطور - الأزرق الصافي ]
-- ========================================================
local CyberTheme = {
    MainColor = Color3.fromRGB(0, 136, 255),       -- أزرق صافي
    GlowColor = Color3.fromRGB(0, 85, 255),        -- أزرق عميق
    ObjectsToColor = {}                            
}

local currentHex = "#0088ff"

local function ApplyThemeColor(color, glowColor)
    local newHex = string.format("#%02x%02x%02x", math.floor(color.R*255), math.floor(color.G*255), math.floor(color.B*255))
    for _, data in pairs(LangData) do
        if data.IsRichText then
            data.AR = string.gsub(data.AR, currentHex, newHex)
            data.EN = string.gsub(data.EN, currentHex, newHex)
        end
    end
    currentHex = newHex
    UpdateLanguage()

    CyberTheme.MainColor = color
    CyberTheme.GlowColor = glowColor or color
    for obj, propType in pairs(CyberTheme.ObjectsToColor) do
        if obj and obj.Parent then
            if propType == "Color" then obj.Color = color
            elseif propType == "BackgroundColor3" then obj.BackgroundColor3 = color
            elseif propType == "TextColor3" then obj.TextColor3 = color
            elseif propType == "ImageColor3" then obj.ImageColor3 = color
            elseif propType == "Glow" then obj.Color = glowColor or color
            elseif propType == "FillColor" then obj.FillColor = color
            elseif propType == "ScrollBarImageColor3" then obj.ScrollBarImageColor3 = color end
        elseif obj then
            CyberTheme.ObjectsToColor[obj] = nil
        end
    end
end

