local currentPercent = 0
local function advanceLoading(targetPercent, duration, message)
    statusText.Text = message
    local startPercent = currentPercent
    local startTime = os.clock()
    while os.clock() - startTime < duration do
        local progress = math.min((os.clock() - startTime) / duration, 1)
        currentPercent = math.floor(startPercent + (targetPercent - startPercent) * progress)
        percentText.Text = currentPercent .. "%"
        barFill.Size = UDim2.new(currentPercent / 100, 0, 1, 0)
        task.wait()
    end
    currentPercent = targetPercent
    percentText.Text = currentPercent .. "%"
    barFill.Size = UDim2.new(currentPercent / 100, 0, 1, 0)
end

